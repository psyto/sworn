# ---- browser (read-only; never put a key in a VITE_ variable — Vite ships them to the browser) ----
VITE_RPC_URL=https://rpc.moderato.tempo.xyz
VITE_CHAIN_ID=42431
VITE_NETWORK_LABEL=Moderato testnet
VITE_SWORN_ADDRESS=0x0000000000000000000000000000000000000000
# optional: pin the Sworn runtime codehash (002 §3.3)
VITE_SWORN_CODEHASH=
VITE_EXPLORER_URL=https://explore.testnet.tempo.xyz
# how far back the phone view scans for events (blocks)
VITE_FEED_LOOKBACK=20000

# ---- demo backend (Node, holds keys; never served to the browser) ----
DEMO_PORT=8788
DEMO_RPC_URL=http://127.0.0.1:8545
SWORN_ADDRESS=0x0000000000000000000000000000000000000000
# the agent wallet that buys preflights, pays and is paid on a slash
DEMO_CLIENT_KEY=
DEMO_TOKEN=0x20C0000000000000000000000000000000000000
DEMO_FEE_TOKEN=0x20C0000000000000000000000000000000000000
DEMO_AMOUNT=500
DEMO_RECEIVER=
# R′: a receiver whose receive policy blocks the agent
DEMO_RECEIVER_BLOCKED=
HONEST_SERVER_URL=http://127.0.0.1:8790
DISHONEST_SERVER_URL=http://127.0.0.1:8791
# module exporting the SDK (002 §1); defaults to ../sdk/src/index.ts, then ../sdk/dist/index.js
SWORN_SDK_PATH=
# optional: a recorded SP1 proving log to offer as a *labelled* fast-forward (e.g. ../out/ac7_groth16.log)
DEMO_RECORDING_LOG=
# the backend refuses to send transactions to a non-localhost RPC unless this is 1
DEMO_ALLOW_REMOTE_TX=0
