diff --git a/crates/nitro-attestation/src/rustcrypto_p384.rs b/crates/nitro-attestation/src/rustcrypto_p384.rs
new file mode 100644
index 0000000..d197ebc
--- /dev/null
+++ b/crates/nitro-attestation/src/rustcrypto_p384.rs
@@ -0,0 +1,30 @@
+//! SPIKE-PATCH-2: pure-Rust (RustCrypto p384 + sha2) backend for zkvm targets, exported as
+//! `AwsLcP384` so callers need no change. Semantics intended to match the AWS-LC backend.
+use crate::{
+    P384_FIXED_SIGNATURE_SIZE, P384_PUBLIC_KEY_SIZE, P384Verifier, SHA384_SIZE, Sha384Hasher,
+};
+use p384::ecdsa::{Signature, VerifyingKey, signature::hazmat::PrehashVerifier};
+use sha2::{Digest, Sha384};
+
+/// Pure-Rust backend for SHA-384 hashing and P-384 verification.
+pub struct AwsLcP384;
+
+impl Sha384Hasher for AwsLcP384 {
+    fn sha384(&self, input: &[u8]) -> [u8; SHA384_SIZE] {
+        Sha384::digest(input).into()
+    }
+}
+
+impl P384Verifier for AwsLcP384 {
+    fn validate_public_key(&self, public_key: &[u8; P384_PUBLIC_KEY_SIZE]) -> bool {
+        VerifyingKey::from_sec1_bytes(public_key).is_ok()
+    }
+    fn verify_der(&self, pk: &[u8; P384_PUBLIC_KEY_SIZE], digest: &[u8; SHA384_SIZE], sig: &[u8]) -> bool {
+        let (Ok(k), Ok(s)) = (VerifyingKey::from_sec1_bytes(pk), Signature::from_der(sig)) else { return false };
+        k.verify_prehash(digest, &s).is_ok()
+    }
+    fn verify_fixed(&self, pk: &[u8; P384_PUBLIC_KEY_SIZE], digest: &[u8; SHA384_SIZE], sig: &[u8; P384_FIXED_SIGNATURE_SIZE]) -> bool {
+        let (Ok(k), Ok(s)) = (VerifyingKey::from_sec1_bytes(pk), Signature::from_slice(sig)) else { return false };
+        k.verify_prehash(digest, &s).is_ok()
+    }
+}
