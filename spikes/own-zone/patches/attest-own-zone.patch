+
+/// OWN-ZONE: a genesis artifact that pins a standalone portal (`swornZonePortal`) must also carry every
+/// fork activation itself. Its spec is then built against the small DEV L1 spec instead of the built-in
+/// parent spec: for parent 42431 that is MODERATO, whose 2.6 MB genesis costs ~250M zkVM cycles to load.
+/// Inheritance only fills *missing* `*Block`/`*Time` fields, and the check below makes sure none is
+/// missing, so the resulting spec is exactly what the artifact says. Other artifacts are unchanged.
+fn zone_chainspec_for(genesis: alloy_genesis::Genesis) -> Result<zone_chainspec::ZoneChainSpec, Error> {
+    if genesis.config.extra_fields.contains_key("swornZonePortal") {
+        let zone = serde_json::to_value(&genesis.config).map_err(|e| Error::Genesis(e.to_string()))?;
+        let dev = serde_json::to_value(&tempo_chainspec::spec::DEV.inner.genesis().config)
+            .map_err(|e| Error::Genesis(e.to_string()))?;
+        for name in dev.as_object().into_iter().flat_map(|o| o.keys()) {
+            if (name.ends_with("Block") || name.ends_with("Time")) && zone.get(name).is_none() {
+                return Err(Error::Genesis(format!("own-zone genesis must pin `{name}`")));
+            }
+        }
+        return zone_chainspec::ZoneChainSpec::from_genesis_with_l1(genesis, &tempo_chainspec::spec::DEV)
+            .map_err(|e| Error::ChainSpec(format!("{e:?}")));
+    }
+    zone_chainspec::ZoneChainSpec::from_genesis(genesis).map_err(|e| Error::ChainSpec(format!("{e:?}")))
 }
 
