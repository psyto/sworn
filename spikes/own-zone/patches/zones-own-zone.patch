+/// Real Groth16 end to end: SwornZoneVerifier wired to the real SP1 Groth16 verifier (v6.1.0),
+/// pinned to this zone's genesis; the sequencer waits for `OWN_ZONE_PROOF_DIR/<nextBlockHash>.proof`
+/// produced by `spikes/own-zone/scripts/prover-watch.sh`. Long (one Groth16 per batch).
+#[tokio::test(flavor = "multi_thread")]
+#[ignore = "needs the Sworn prover watcher; ~15 min per batch"]
+async fn test_own_portal_real_groth16() -> eyre::Result<()> {
+    reth_tracing::init_test_tracing();
+    let vkey: B256 = std::env::var("OWN_ZONE_VKEY")?.parse()?;
+    let dump = std::env::var("ZONE_SPF_DUMP_DIR")?;
+    let timeout = Duration::from_secs(
+        std::env::var("OWN_ZONE_TIMEOUT_S").ok().and_then(|v| v.parse().ok()).unwrap_or(5400),
+    );
+
+    let l1 = start_moderato_like_l1().await?;
+    let provider = l1.dev_provider();
+    let dev = l1.dev_address();
+
+    // 1. the real SP1 Groth16 verifier (same bytecode as Moderato's 0x2c77…9B18 gateway route)
+    let sp1 = deploy(&l1, artifact_at("SP1VerifierGroth16.sol", "SP1Verifier")?).await?;
+
+    // 2. genesis anchored before the portal exists; portal address predicted from the deployer nonce
+    let anchor = provider.get_block_number().await?;
+    let nonce = provider.get_transaction_count(dev).await?;
+    let predicted_verifier = dev.create(nonce);
+    let predicted_portal = dev.create(nonce + 1);
+    let (genesis, artifact_hash, artifact_bytes) = own_genesis_at(&l1, predicted_portal, anchor).await?;
+
+    // 3. verifier pinned to that artifact, then the portal (must land on the predicted addresses)
+    let mut v_init = artifact("SwornZoneVerifier")?;
+    v_init.extend_from_slice(&(sp1, vkey, U256::from(42431u64), ZONE_ID, artifact_hash).abi_encode_params());
+    let verifier = deploy(&l1, v_init).await?;
+    let portal = deploy(&l1, artifact("OwnZonePortal")?).await?;
+    eyre::ensure!(verifier == predicted_verifier && portal == predicted_portal, "address prediction");
+    let init = initializeCall {
+        _zoneId: ZONE_ID,
+        _initialToken: PATH_USD_ADDRESS,
+        accessEnforced: false,
+        gatewayEnforced: false,
+        _allowedAccounts: vec![],
+        _zoneGateways: vec![],
+        _messenger: MESSENGER,
+        _admin: l1.admin_address(),
+        initialSequencers: vec![dev],
+        _threshold: 1,
+        _verifier: verifier,
+        _rpcUrl: String::new(),
+    };
+    let receipt = provider
+        .send_transaction(TransactionRequest::default().to(portal).input(init.abi_encode().into()))
+        .await?
+        .get_receipt()
+        .await?;
+    eyre::ensure!(receipt.status(), "initialize failed");
+    l1.fund_user(l1.admin_address(), 10_000_000).await?;
+    let encryption_key = k256::SecretKey::from(l1.dev_signer().credential());
+    l1.set_sequencer_encryption_key(portal, &encryption_key).await?;
+    std::fs::write(format!("{dump}/own-zone-pinned.genesis.json"), &artifact_bytes)?;
+    std::fs::write(
+        format!("{dump}/own-zone-addresses.json"),
+        serde_json::to_vec_pretty(&serde_json::json!({
+            "l1ChainId": 42431, "sp1Groth16": sp1, "verifier": verifier, "portal": portal,
+            "zoneId": ZONE_ID, "vkey": vkey, "genesisArtifactHash": artifact_hash,
+            "genesisAnchorBlock": anchor, "initializeBlock": receipt.block_number,
+        }))?,
+    )?;
+    println!("OWN-ZONE real: sp1 {sp1} verifier {verifier} portal {portal} genesis {artifact_hash} anchor {anchor}");
+
+    // 4. zone from that exact genesis
+    let zone = ZoneTestNode::start_with_own_genesis(l1.ws_url(), portal, genesis).await?;
+    zone.wait_for_l2_tempo_finalized(0, L1_TIMEOUT).await?;
+    let recipient_signer = l1.signer_at(2);
+    let recipient = recipient_signer.address();
+    let mut depositor = ZoneAccount::from_l1_and_zone(&l1, &zone, portal);
+    l1.fund_user(depositor.address(), 1_000_000).await?;
+    depositor.deposit_with_memo(1_000_000, recipient, B256::ZERO, L1_TIMEOUT, &zone).await?;
+    println!("OWN-ZONE real: deposit minted on zone");
+
+    let _sequencer = spawn_sequencer(&l1, &zone, portal, l1.dev_signer()).await;
+    let mut recipient_account = ZoneAccount::with_signer(recipient_signer, &l1, &zone, portal);
+    let before = l1.balance_of(PATH_USD_ADDRESS, recipient).await?;
+    recipient_account.withdraw(500_000).await?;
+    l1.wait_for_withdrawal_on_l1(portal, recipient, before, 500_000, timeout).await?;
+    println!("OWN-ZONE real: withdrawal paid on L1 after Groth16-verified settlement");
+    Ok(())
+}
