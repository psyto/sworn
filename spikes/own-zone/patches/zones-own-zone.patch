+//! OWN-ZONE (Sworn spike): deterministic Zone genesis for a standalone (non-factory) portal.
+//!
+//! Given an L1 anchor block and the portal address (or deployer + CREATE nonce), writes:
+//!   <out>/genesis.json           the file to pass to `tempo-zone node --chain`
+//!   <out>/genesis-artifact.json  the exact bytes the node hands the guest (keccak = verifier pin)
+//!   <out>/summary.json           anchor, portal, ids, keccak
+//! Same inputs -> same bytes. Read-only RPC (eth_chainId, eth_getBlockByNumber, eth_getCode).
+use alloy_consensus::Sealable as _;
+use alloy_primitives::{Address, B256, keccak256};
+use reth_chainspec::EthChainSpec as _;
+use alloy_provider::{Provider, ProviderBuilder};
+use clap::Parser;
+use eyre::{WrapErr as _, ensure, eyre};
+use tempo_alloy::TempoNetwork;
+use tempo_primitives::TempoHeader;
+
+#[derive(Parser, Debug)]
+struct Args {
+    /// Tempo L1 HTTP RPC (read-only use).
+    #[arg(long)]
+    l1_rpc: String,
+    /// Anchor block number: must be BEFORE the portal is deployed.
+    #[arg(long)]
+    anchor: u64,
+    #[arg(long)]
+    zone_id: u32,
+    /// Portal address (alternative to --deployer/--portal-nonce).
+    #[arg(long)]
+    portal: Option<Address>,
+    /// Portal deployer; the portal address is CREATE(deployer, portal_nonce).
+    #[arg(long)]
+    deployer: Option<Address>,
+    #[arg(long)]
+    portal_nonce: Option<u64>,
+    /// Refuse unless the L1 reports this chain id.
+    #[arg(long, default_value_t = 42431)]
+    expect_chain_id: u64,
+    #[arg(long)]
+    out: std::path::PathBuf,
+}
+
+const FORKS: [&str; 17] = [
+    "t0Time", "t1Time", "t1aTime", "t1bTime", "t1cTime", "t2Time", "t3Time", "t4Time", "t5Time",
+    "t6Time", "t7Time", "t8Time", "t9Time", "t10Time", "t11Time", "t12Time", "t13Time",
+];
+
+#[tokio::main]
+async fn main() -> eyre::Result<()> {
+    let args = Args::parse();
+    let portal = match (args.portal, args.deployer, args.portal_nonce) {
+        (Some(p), None, None) => p,
+        (None, Some(d), Some(n)) => d.create(n),
+        _ => return Err(eyre!("give --portal, or --deployer and --portal-nonce")),
+    };
+    let provider = ProviderBuilder::new_with_network::<TempoNetwork>()
+        .connect(&args.l1_rpc)
+        .await
+        .wrap_err("connect L1")?;
+    let parent_chain_id = provider.get_chain_id().await?;
+    ensure!(
+        parent_chain_id == args.expect_chain_id,
+        "L1 chain id {parent_chain_id} != expected {}",
+        args.expect_chain_id
+    );
+    let block = provider
+        .get_block_by_number(args.anchor.into())
+        .await?
+        .ok_or_else(|| eyre!("anchor block {} not found", args.anchor))?;
+    let header: &TempoHeader = block.header.as_ref();
+    let anchor_hash = header.hash_slow();
+    ensure!(anchor_hash == block.header.hash, "anchor header hash mismatch (non-canonical header encoding?)");
+    let code = provider.get_code_at(portal).block_id(args.anchor.into()).await?;
+    ensure!(code.is_empty(), "portal {portal} already has code at anchor block {}: the anchor must precede the portal deployment", args.anchor);
+
+    let (mut genesis, _) =
+        zone_node::genesis::l1_anchored_genesis(header, tempo_precompiles::PATH_USD_ADDRESS)?;
+    genesis.config.chain_id = zone_primitives::constants::zone_chain_id(parent_chain_id, args.zone_id)?;
+    genesis
+        .config
+        .extra_fields
+        .insert("swornZonePortal".to_string(), serde_json::Value::String(portal.to_string()));
+    for fork in FORKS {
+        genesis.config.extra_fields.insert(fork.to_string(), serde_json::Value::from(0u64));
+    }
+    // Exactly what the node's prover dumps: the composed chainspec genesis, via serde_json::Value.
+    let spec = zone_chainspec::ZoneChainSpec::from_genesis(genesis.clone())?;
+    let artifact = serde_json::to_vec(&serde_json::to_value(spec.inner.genesis())?)?;
+    let artifact_hash: B256 = keccak256(&artifact);
+
+    std::fs::create_dir_all(&args.out)?;
+    std::fs::write(args.out.join("genesis.json"), serde_json::to_vec_pretty(&genesis)?)?;
+    std::fs::write(args.out.join("genesis-artifact.json"), &artifact)?;
+    let summary = serde_json::json!({
+        "parentChainId": parent_chain_id,
+        "zoneId": args.zone_id,
+        "zoneChainId": genesis.config.chain_id,
+        "anchorBlock": args.anchor,
+        "anchorHash": anchor_hash,
+        "portal": portal,
+        "deployer": args.deployer,
+        "portalNonce": args.portal_nonce,
+        "genesisArtifactBytes": artifact.len(),
+        "genesisArtifactKeccak": artifact_hash,
+    });
+    std::fs::write(args.out.join("summary.json"), serde_json::to_vec_pretty(&summary)?)?;
+    println!("{}", serde_json::to_string_pretty(&summary)?);
+    Ok(())
+}
