+/// Production-order genesis: anchored at an L1 block *before* the portal exists (like the factory's
+/// pre-creation anchor), pinning the (predicted) portal address and every fork. Returns the genesis
+/// to launch with, and keccak256 of the exact artifact bytes the node will dump for the guest.
+async fn own_genesis_at(
+    l1: &L1TestNode,
+    portal: Address,
+    anchor_block: u64,
+) -> eyre::Result<(alloy_genesis::Genesis, B256, Vec<u8>)> {
+    let l1_provider = alloy::providers::ProviderBuilder::new_with_network::<tempo_alloy::TempoNetwork>()
+        .connect_http(l1.http_url().clone());
+    let block = l1_provider
+        .get_block_by_number(anchor_block.into())
+        .await?
+        .ok_or_else(|| eyre::eyre!("anchor block"))?;
+    let header: &tempo_primitives::TempoHeader = block.header.as_ref();
+    let (mut genesis, _) = zone_node::genesis::l1_anchored_genesis(header, PATH_USD_ADDRESS)?;
+    genesis.config.extra_fields.insert(
+        "swornZonePortal".to_string(),
+        serde_json::Value::String(portal.to_string()),
+    );
+    for fork in [
+        "t0Time", "t1Time", "t1aTime", "t1bTime", "t1cTime", "t2Time", "t3Time", "t4Time", "t5Time",
+        "t6Time", "t7Time", "t8Time", "t9Time", "t10Time", "t11Time", "t12Time", "t13Time",
+    ] {
+        genesis.config.extra_fields.insert(fork.to_string(), serde_json::Value::from(0u64));
+    }
+    let mut with_id = genesis.clone();
+    with_id.config.chain_id = zone_primitives::constants::zone_chain_id(42431, ZONE_ID)?;
+    let spec = zone_chainspec::ZoneChainSpec::from_genesis(with_id)?;
+    let bytes = serde_json::to_vec(&serde_json::to_value(spec.inner.genesis())?)?;
+    Ok((genesis, alloy::primitives::keccak256(&bytes), bytes))
+}
