+//! OWN-ZONE rehearsal (Sworn spike, spikes/own-zone): a Zone whose portal is a standalone Solidity
+//! `OwnZonePortal` (not created by the native ZoneFactory) and whose verifier is `SwornZoneVerifier`.
+//!
+//! The L1 is a real in-process Tempo dev node (pinned tempo 346c22eb) configured like Moderato:
+//! chain id 42431, T11 active (no T12/T13), eth_getProof window 250 blocks. The SP1 verifier
+//! behind SwornZoneVerifier is an accept-all mock, so the batch settles without a Groth16 proof;
+//! the witness the sequencer validated is dumped (ZONE_SPF_DUMP_DIR) for the zkVM guest.
+//!
+//! Env: OWN_ZONE_ARTIFACTS = path to spikes/own-zone/contracts/out (forge build output).
+
+use crate::utils::{L1TestNode, ZoneAccount, ZoneTestNode, spawn_sequencer};
+use alloy::{
+    primitives::{Address, B256, Bytes, U256, TxKind},
+    providers::Provider,
+    sol,
+    sol_types::{SolCall, SolValue},
+};
+use alloy_rpc_types_eth::TransactionRequest;
+use reth_chainspec::EthChainSpec as _;
+use std::time::Duration;
+use tempo_precompiles::PATH_USD_ADDRESS;
+
+const L1_TIMEOUT: Duration = Duration::from_secs(60);
+const ZONE_ID: u32 = 4242;
+const VKEY: B256 = alloy::primitives::b256!(
+    "007ef7314d2624af811844d494aac02736de7a36ce6f5ef52345fcd0bdac5b39"
+);
+const MESSENGER: Address = alloy::primitives::address!("5A4d000000000000000000000000000000000000");
+
+sol! {
+    function initialize(
+        uint32 _zoneId,
+        address _initialToken,
+        bool accessEnforced,
+        bool gatewayEnforced,
+        address[] _allowedAccounts,
+        address[] _zoneGateways,
+        address _messenger,
+        address _admin,
+        address[] initialSequencers,
+        uint8 _threshold,
+        address _verifier,
+        string _rpcUrl
+    );
+    function withdrawalBatchIndex() external view returns (uint64);
+    function verifier() external view returns (address);
+}
+
+fn artifact(name: &str) -> eyre::Result<Vec<u8>> {
+    let dir = std::env::var("OWN_ZONE_ARTIFACTS")
+        .map_err(|_| eyre::eyre!("set OWN_ZONE_ARTIFACTS to spikes/own-zone/contracts/out"))?;
+    let path = std::path::Path::new(&dir).join(format!("{name}.sol/{name}.json"));
+    let json: serde_json::Value = serde_json::from_str(&std::fs::read_to_string(&path)?)?;
+    let hex = json["bytecode"]["object"].as_str().ok_or_else(|| eyre::eyre!("no bytecode"))?;
+    Ok(alloy::primitives::hex::decode(hex)?)
+}
+
+async fn deploy(l1: &L1TestNode, init: Vec<u8>) -> eyre::Result<Address> {
+    let provider = l1.dev_provider();
+    let mut tx = TransactionRequest::default().input(Bytes::from(init).into());
+    tx.to = Some(TxKind::Create);
+    let receipt = provider.send_transaction(tx).await?.get_receipt().await?;
+    eyre::ensure!(receipt.status(), "deployment failed");
+    receipt.contract_address.ok_or_else(|| eyre::eyre!("no contract address"))
+}
+
+async fn start_moderato_like_l1() -> eyre::Result<L1TestNode> {
+    let window: u64 = std::env::var("OWN_ZONE_L1_PROOF_WINDOW")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(250);
+    L1TestNode::start_with(move |cfg| {
+        let mut genesis = cfg.chain.genesis().clone();
+        genesis.config.chain_id = 42431;
+        // Moderato today: T11 active, T12 scheduled 2026-10-08, T13 unscheduled.
+        if std::env::var("OWN_ZONE_L1_T13").is_err() {
+            genesis.config.extra_fields.remove("t12Time");
+            genesis.config.extra_fields.remove("t13Time");
+        }
+        cfg.chain = std::sync::Arc::new(tempo_chainspec::TempoChainSpec::from_genesis(genesis));
+        cfg.rpc.rpc_eth_proof_window = window;
+    })
+    .await
+}
