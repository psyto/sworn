+#[tokio::test(flavor = "multi_thread")]
+async fn test_own_portal_deposit_and_withdrawal() -> eyre::Result<()> {
+    reth_tracing::init_test_tracing();
+
+    // --- L1 shaped like Moderato ---
+    let l1 = start_moderato_like_l1().await?;
+    let provider = l1.dev_provider();
+    let chain_id = provider.get_chain_id().await?;
+    eyre::ensure!(chain_id == 42431, "L1 chain id {chain_id}");
+    let fork: serde_json::Value = provider.raw_request("tempo_forkSchedule".into(), ()).await?;
+    println!("OWN-ZONE L1 chain {chain_id}, tempo_forkSchedule.active = {}", fork["active"]);
+
+    // --- Contracts: accept-all SP1 mock -> SwornZoneVerifier -> OwnZonePortal ---
+    let mock_sp1 = deploy(&l1, artifact("AcceptAllSP1")?).await?;
+    let mut v_init = artifact("SwornZoneVerifier")?;
+    v_init.extend_from_slice(
+        &(mock_sp1, VKEY, U256::from(42431u64), ZONE_ID, B256::repeat_byte(0x11)).abi_encode_params(),
+    );
+    let verifier = deploy(&l1, v_init).await?;
+    let portal = deploy(&l1, artifact("OwnZonePortal")?).await?;
+    let init = initializeCall {
+        _zoneId: ZONE_ID,
+        _initialToken: PATH_USD_ADDRESS,
+        accessEnforced: false,
+        gatewayEnforced: false,
+        _allowedAccounts: vec![],
+        _zoneGateways: vec![],
+        _messenger: MESSENGER,
+        _admin: l1.admin_address(),
+        initialSequencers: vec![l1.dev_address()],
+        _threshold: 1,
+        _verifier: verifier,
+        _rpcUrl: String::new(),
+    };
+    let receipt = provider
+        .send_transaction(TransactionRequest::default().to(portal).input(init.abi_encode().into()))
+        .await?
+        .get_receipt()
+        .await?;
+    eyre::ensure!(receipt.status(), "OwnZonePortal.initialize failed");
+    l1.fund_user(l1.admin_address(), 10_000_000).await?;
+    let encryption_key = k256::SecretKey::from(l1.dev_signer().credential());
+    l1.set_sequencer_encryption_key(portal, &encryption_key).await?;
+    println!("OWN-ZONE mockSP1 {mock_sp1} verifier {verifier} portal {portal}");
+
+    // --- Zone node against the non-factory portal ---
+    let (zone, genesis) =
+        ZoneTestNode::start_from_l1_own_portal(l1.http_url(), l1.ws_url(), portal).await?;
+    if let Ok(dir) = std::env::var("ZONE_SPF_DUMP_DIR") {
+        std::fs::write(
+            format!("{dir}/own-zone-genesis.json"),
+            serde_json::to_vec_pretty(&genesis)?,
+        )?;
+        std::fs::write(
+            format!("{dir}/own-zone-addresses.json"),
+            serde_json::to_vec_pretty(&serde_json::json!({
+                "l1ChainId": chain_id, "mockSp1": mock_sp1, "verifier": verifier, "portal": portal,
+                "zoneId": ZONE_ID, "zoneChainId": zone_primitives::constants::zone_chain_id(42431, ZONE_ID)?,
+            }))?,
+        )?;
+    }
+    println!("OWN-ZONE zone chain id {}", zone_primitives::constants::zone_chain_id(42431, ZONE_ID)?);
+    zone.wait_for_l2_tempo_finalized(0, L1_TIMEOUT).await?;
+
+    // --- Deposit ---
+    let recipient_signer = l1.signer_at(2);
+    let recipient = recipient_signer.address();
+    let mut depositor = ZoneAccount::from_l1_and_zone(&l1, &zone, portal);
+    let deposit_amount: u128 = 1_000_000;
+    l1.fund_user(depositor.address(), deposit_amount).await?;
+    depositor
+        .deposit_with_memo(deposit_amount, recipient, B256::ZERO, L1_TIMEOUT, &zone)
+        .await?;
+    println!("OWN-ZONE deposit minted on zone");
+
+    // --- Sequencer (submitBatch -> SwornZoneVerifier) + withdrawal ---
+    let _sequencer = spawn_sequencer(&l1, &zone, portal, l1.dev_signer()).await;
+    let mut recipient_account = ZoneAccount::with_signer(recipient_signer, &l1, &zone, portal);
+    let withdrawal_amount: u128 = 500_000;
+    let before = l1.balance_of(PATH_USD_ADDRESS, recipient).await?;
+    recipient_account.withdraw(withdrawal_amount).await?;
+    l1.wait_for_withdrawal_on_l1(portal, recipient, before, withdrawal_amount, L1_TIMEOUT)
+        .await?;
+    let index = provider
+        .call(TransactionRequest::default().to(portal).input(withdrawalBatchIndexCall {}.abi_encode().into()))
+        .await?;
+    println!(
+        "OWN-ZONE withdrawal paid on L1 through OwnZonePortal; withdrawalBatchIndex = {}",
+        U256::from_be_slice(&index)
+    );
+
+    // Record every submitBatch the sequencer sent: the exact verifier inputs the portal used.
+    if let Ok(dir) = std::env::var("ZONE_SPF_DUMP_DIR") {
+        use alloy::rpc::types::Filter;
+        let logs = provider
+            .get_logs(&Filter::new().address(portal).from_block(0u64))
+            .await?;
+        let mut batches = Vec::new();
+        for log in logs {
+            let Some(tx_hash) = log.transaction_hash else { continue };
+            // Tempo AA transactions (type 0x76) carry `calls`; read the raw JSON.
+            let tx: serde_json::Value =
+                provider.raw_request("eth_getTransactionByHash".into(), (tx_hash,)).await?;
+            let input_hex = tx["calls"][0]["input"]
+                .as_str()
+                .or_else(|| tx["input"].as_str())
+                .unwrap_or("0x");
+            let input = alloy::primitives::hex::decode(input_hex)?;
+            if let Ok(call) = tempo_zone_contracts::submitBatchCall::abi_decode(&input) {
+                if batches.iter().any(|(h, _): &(B256, serde_json::Value)| *h == tx_hash) {
+                    continue;
+                }
+                let receipt: serde_json::Value = provider
+                    .raw_request("eth_getTransactionReceipt".into(), (tx_hash,))
+                    .await?;
+                batches.push((tx_hash, serde_json::json!({
+                    "txHash": tx_hash,
+                    "l1Block": receipt["blockNumber"],
+                    "gasUsed": receipt["gasUsed"],
+                    "status": receipt["status"],
+                    "tempoBlockNumber": call.tempoBlockNumber,
+                    "recentTempoBlockNumber": call.recentTempoBlockNumber,
+                    "prevBlockHash": call.blockTransition.prevBlockHash,
+                    "nextBlockHash": call.blockTransition.nextBlockHash,
+                    "prevProcessedHash": call.depositQueueTransition.prevProcessedHash,
+                    "nextProcessedHash": call.depositQueueTransition.nextProcessedHash,
+                    "prevDepositNumber": call.depositQueueTransition.prevDepositNumber,
+                    "nextDepositNumber": call.depositQueueTransition.nextDepositNumber,
+                    "prevProcessedTokenCount": call.tokenEnablementTransition.prevProcessedTokenCount,
+                    "nextProcessedTokenCount": call.tokenEnablementTransition.nextProcessedTokenCount,
+                    "withdrawalQueueHash": call.withdrawalQueueHash,
+                    "verifierConfig": call.verifierConfig,
+                    "proof": call.proof,
+                    "nextZoneHeight": call.nextZoneHeight,
+                    "anchorBlockHash": provider
+                        .get_block_by_number(call.tempoBlockNumber.into())
+                        .await?
+                        .map(|b| b.header.hash),
+                })));
+            }
+        }
+        let batches: Vec<_> = batches.into_iter().map(|(_, v)| v).collect();
+        println!("OWN-ZONE recorded {} submitBatch calls", batches.len());
+        std::fs::write(format!("{dir}/own-zone-submitbatch.json"), serde_json::to_vec_pretty(&batches)?)?;
+    }
+    Ok(())
+}
