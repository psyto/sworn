+/// SPIKE-WITHDRAWAL: test-only observational settlement prover. When `ZONE_SPF_OBSERVE_PROVER` is
+/// set, the settlement path runs the in-process SPF on every candidate (so `validate_candidate`, and
+/// the SPIKE-DUMP, run on real settlement batches) but does not require durable witness persistence
+/// or a Nitro attestation; the batch is then submitted exactly as with no prover configured.
+pub(crate) fn spike_observe_prover() -> bool {
+    std::env::var_os("ZONE_SPF_OBSERVE_PROVER").is_some()
+}
