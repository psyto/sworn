+
+/// SPIKE-DUMP: write `{genesis, witness}` (the SP1 guest input) when ZONE_SPF_DUMP_DIR is set.
+pub(crate) fn spike_dump_case(
+    name: &str,
+    config: &SpfConfig,
+    witness: &BatchWitness,
+) -> Option<String> {
+    let dir = std::env::var("ZONE_SPF_DUMP_DIR").ok()?;
+    let genesis = config.chain_spec().inner.genesis().clone();
+    // The guest rebuilds the spec from this genesis; make sure that is lossless.
+    assert_eq!(
+        &ZoneChainSpec::from_genesis(genesis.clone()).expect("rebuild spec"),
+        config.chain_spec().as_ref(),
+        "dumped genesis must rebuild the identical ZoneChainSpec"
+    );
+    let path = format!("{dir}/{name}");
+    let case = serde_json::json!({ "genesis": genesis, "witness": witness });
+    std::fs::write(format!("{path}.case.json"), serde_json::to_vec(&case).unwrap()).unwrap();
+    Some(path)
+}
+
+/// SPIKE-DUMP: write the natively computed BatchOutput next to the case.
+pub(crate) fn spike_dump_output(path: Option<String>, output: &zone_spf::BatchOutput) {
+    if let Some(path) = path {
+        std::fs::write(format!("{path}.native-output.json"), serde_json::to_vec(output).unwrap())
+            .unwrap();
+    }
+}
