+#[cfg(feature = "node")]
+pub type DefaultL1 = L1StateProvider;
+/// SPIKE-ZKVM-1: see above.
+#[cfg(not(feature = "node"))]
+pub type DefaultL1 = NoL1Reader;
+
+/// SPIKE-ZKVM-1: L1 reader used only as a default type parameter without `node`.
+#[cfg(not(feature = "node"))]
+#[derive(Clone, Debug, Default)]
+pub struct NoL1Reader;
+
+#[cfg(not(feature = "node"))]
+impl L1StorageReader for NoL1Reader {
+    fn read_l1_storage(
+        &self,
+        account: Address,
+        slot: B256,
+        block_number: u64,
+    ) -> Result<B256, zone_precompiles::L1StateError> {
+        Err(zone_precompiles::L1StateError::StorageUnavailable {
+            account,
+            slot,
+            block_number,
+            reason: "no L1 reader".into(),
+        })
+    }
+}
